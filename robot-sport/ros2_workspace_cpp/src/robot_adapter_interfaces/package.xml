<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_adapter_interfaces</name>
  <version>0.1.0</version>
  <description>Shared C++ interfaces and switch state machine for robot adapters.</description>
  <maintainer email="dev@example.com">robot-sport</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>ament_index_cpp</depend>
  <depend>rcl_yaml_param_parser</depend>
  <depend>nlohmann_json</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
