#!/bin/bash
set -e

case "$1" in
    configure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
            systemctl enable robot-sport.service || true
            if systemctl is-active --quiet robot-sport.service; then
                systemctl restart robot-sport.service || true
            else
                systemctl start robot-sport.service || true
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
