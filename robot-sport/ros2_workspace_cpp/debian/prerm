#!/bin/bash
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop robot-sport.service || true
            if [ "$1" != "upgrade" ]; then
                systemctl disable robot-sport.service || true
            fi
        fi
        ;;
    failed-upgrade)
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
