# 基于 Google C++ Style Guide 的 clang-format 配置
# 参考：https://google.github.io/styleguide/cppguide.html

Language: Cpp                # 指定格式化的编程语言为 C++
# 基于 Google 的预设风格，这是最接近的起点
BasedOnStyle: Google         # 使用 Google 风格作为基础模板

# 以下是针对 Google 风格指南的明确设置和微调

#
# 格式规范
#
AccessModifierOffset: -4      # 访问修饰符（public, private）与类声明相同缩进
AlignAfterOpenBracket: Align # 函数参数在开括号后对齐，多行参数垂直对齐
AlignConsecutiveMacros: false # 不对齐连续的宏定义，保持自然格式
AlignConsecutiveAssignments: false # 不对齐连续的赋值语句的等号
AlignConsecutiveDeclarations: false # 不对齐连续的变量声明
AlignEscapedNewlines: Left   # 多行宏的反斜杠左对齐
AlignOperands: true          # 对齐多行表达式的操作数，提高可读性
AlignTrailingComments: true  # 对齐行尾注释，使注释列整齐

AllowAllParametersOfDeclarationOnNextLine: false # 不允许函数声明的所有参数都放在下一行
# 允许函数声明的所有参数放在下一行
AllowShortBlocksOnASingleLine: Never # 禁止任何代码块在单行，强制使用多行格式
AllowShortCaseLabelsOnASingleLine: false # 禁止 case 标签和语句在同一行
AllowShortFunctionsOnASingleLine: InlineOnly # 只有非常短的 inline 函数可以在一行
AllowShortIfStatementsOnASingleLine: false    # 禁止 if (condition) do_something(); 单行写法
AllowShortLoopsOnASingleLine: false           # 禁止 while (condition) do_something(); 单行写法

AlwaysBreakAfterDefinitionReturnType: None # 函数定义的返回类型不强制换行
AlwaysBreakAfterReturnType: None       # 函数声明的返回类型不强制换行
AlwaysBreakBeforeMultilineStrings: false # 多行字符串前不强制换行
AlwaysBreakTemplateDeclarations: Yes   # 模板声明后总是换行，确保清晰度

BinPackArguments: true      # 允许紧密打包函数调用的参数，尽可能多的参数放在一行
BinPackParameters: true     # 允许紧密打包函数声明的参数，尽可能多的参数放在一行

BraceWrapping:              # 大括号换行的详细设置
  AfterCaseLabel: false     # case 标签后的大括号不换行
  AfterClass: false         # 类声明后的大括号不换行
  AfterControlStatement: Never # 控制语句（if/for/while）后的大括号不换行，采用 K&R 风格
  AfterEnum: false          # 枚举声明后的大括号不换行
  AfterFunction: true       # 函数定义后的大括号换行（Google 风格特色）
  AfterNamespace: false     # 命名空间后的大括号不换行
  AfterObjCDeclaration: false # Objective-C 声明后不换行（C++ 项目中不适用）
  AfterStruct: false        # 结构体声明后的大括号不换行
  AfterUnion: false         # 联合体声明后的大括号不换行
  AfterExternBlock: false   # extern 块后的大括号不换行
  BeforeCatch: false        # catch 前的大括号不换行
  BeforeElse: false         # else 与前一个 } 在同一行，不换行
  IndentBraces: false       # 大括号本身不缩进
  SplitEmptyFunction: false # 空函数的大括号不分行
  SplitEmptyRecord: false   # 空类/结构体的大括号不分行
  SplitEmptyNamespace: false # 空命名空间的大括号不分行

BreakBeforeBinaryOperators: None # 在二元操作符后换行，而不是前面
BreakBeforeBraces: Attach    # 大括号采用 Attach 风格（左大括号不换行）
BreakBeforeInheritanceComma: false # 继承列表的逗号前不换行
BreakBeforeTernaryOperators: true  # 三元操作符前换行，提高可读性
BreakConstructorInitializers: BeforeComma # 构造函数初始化列表在逗号前换行
BreakInheritanceList: BeforeComma  # 继承列表在逗号前换行

BreakStringLiterals: true    # 允许长字符串字面量在任意字符处断开以适应行宽

ColumnLimit: 80              # 行宽限制：80 字符，Google 风格的标准行宽
CompactNamespaces: false     # 不紧凑命名空间，每个命名空间单独一行
ConstructorInitializerIndentWidth: 4 # 构造函数初始化列表的缩进宽度为 4 个空格
ContinuationIndentWidth: 4   # 续行的缩进宽度为 4 个空格

Cpp11BracedListStyle: true   # 使用 C++11 的统一初始化语法（大括号）风格
DerivePointerAlignment: false # 不从现有代码推导指针对齐方式，使用显式设置
FixNamespaceComments: true   # 自动修复命名空间结束处的注释

IncludeCategories:           # 头文件包含的分类和排序规则
  - Regex: '^<.*\.h>'        # 系统 .h 头文件（如 <stdio.h>）
    Priority: 2              # 优先级 2
  - Regex: '^<.*'            # 其他系统头文件（如 <iostream>）
    Priority: 3              # 优先级 3（最低）
  - Regex: '.*'              # 项目本地头文件
    Priority: 1              # 优先级 1（最高）
IncludeBlocks: Regroup       # 尝试对 #include 块进行分组排序
IncludeIsMainRegex: '(Test)?$' # 识别主头文件的正则表达式
IndentCaseLabels: false      # case 标签不缩进，与 switch 对齐
IndentGotoLabels: false      # goto 标签不缩进
IndentPPDirectives: None     # 预处理指令不缩进，始终从行首开始
IndentWidth: 4               # 缩进：4 个空格
IndentWrappedFunctionNames: false # 换行的函数名不额外缩进

KeepEmptyLinesAtTheStartOfBlocks: false # 不在代码块开始处保留空行
MaxEmptyLinesToKeep: 1       # 最多保留连续 1 个空行，避免过多空白

NamespaceIndentation: None   # 命名空间内容不缩进，节省水平空间
PenaltyBreakAssignment: 100  # 在赋值操作符处换行的惩罚值
PenaltyBreakBeforeFirstCallParameter: 100 # 在第一个函数参数前换行的惩罚值
PenaltyBreakComment: 100     # 在注释中换行的惩罚值
PenaltyBreakFirstLessLess: 100 # 在第一个 << 操作符前换行的惩罚值
PenaltyBreakString: 1000     # 在字符串中换行的惩罚值（较高，尽量避免）
PenaltyExcessCharacter: 1000000 # 超出行宽限制的惩罚值（极高）
PenaltyReturnTypeOnItsOwnLine: 100 # 返回类型单独一行的惩罚值

PointerAlignment: Left       # 指针符号 * 和引用符号 & 靠左，与类型相邻
# 例如: int* ptr; string& str;

ReflowComments: true         # 重新排版注释以适应行宽限制
SortIncludes: true           # 对 #include 进行排序
SortUsingDeclarations: true  # 对 using 声明进行排序

SpaceAfterCStyleCast: false  # C 风格类型转换后不加空格
SpaceAfterLogicalNot: false  # 逻辑非操作符 ! 后不加空格
SpaceAfterTemplateKeyword: false # template 关键字后不加空格
SpaceBeforeAssignmentOperators: true # 赋值操作符前后有空格
SpaceBeforeCpp11BracedList: false # C++11 大括号初始化列表前不加空格
SpaceBeforeCtorInitializerColon: true # 构造函数初始化列表的冒号前加空格
SpaceBeforeInheritanceColon: true # 继承冒号前加空格
SpaceBeforeParens: ControlStatements # 仅在控制语句（if, for, while）后加空格
SpaceBeforeRangeBasedForLoopColon: true # 范围 for 循环的冒号前加空格
SpaceBeforeSquareBrackets: false # 方括号前不加空格
SpaceInEmptyParentheses: false # 空括号内不加空格
SpacesBeforeTrailingComments: 2 # 尾随注释前有 2 个空格
SpacesInAngles: false        # 模板参数的尖括号内不加空格
SpacesInContainerLiterals: false # 容器字面量的括号内不加空格
SpacesInCStyleCastParentheses: false # C 风格类型转换的括号内不加空格
SpacesInParentheses: false   # 普通括号内不加空格
SpacesInSquareBrackets: false # 方括号内不加空格

Standard: Auto               # 自动检测 C++ 标准版本

TabWidth: 4                  # Tab 键宽度设为 4 个空格（用于显示现有的 Tab）
UseTab: Never                # 绝不使用制表符（Tab），始终使用空格进行缩进
