M4T_OPERATOR_TOKEN=replace_with_first_openssl_rand_hex_32_value
M4T_DEVICE_TOKEN=replace_with_second_openssl_rand_hex_32_value
M4T_DEVICE_ID=M4T-001
M4T_EXPECTED_AIRCRAFT_SN=replace_with_M4T_aircraft_SN
M4T_DATABASE_PATH=/var/lib/m4t-relay/relay.db
M4T_ONLINE_THRESHOLD_SECONDS=15
M4T_COMMAND_LEASE_SECONDS=35
M4T_COMMAND_TTL_SECONDS=300
M4T_MAX_POLL_SECONDS=30
M4T_ALLOW_INSECURE_NAVIGATION=false
RELAY_DEVICE_CONFIG_PATH=/etc/m4t-relay-devices.json
